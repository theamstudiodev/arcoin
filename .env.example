# Copy to .env.local for local development. Never commit .env.local.
# Local values come from `supabase status` after `supabase start`.

# Browser-safe. Row-level security applies to everything this key can do.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — bypasses row-level security. Used solely to write task_schedule after the engine runs.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct database connection for scripts (tests, backups, imports). Not used by the app.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Phase 4 — leave empty until then
ANTHROPIC_API_KEY=
